{
  "id": "ad5d92dd-605e-4660-aa43-144691283a57",
  "name": "Post Users",
  "description": "Request to post user collection to import",
  "deserializeAs": "FolioRequestTask",
  "request": {
    "url": "{{{gatewayUrl}}}/user-import",
    "method": "POST",
    "sendEmptyBody": false,
    "bodyTemplate": "${userImportCollection}"
  },
  "inputVariables": [
    {
      "key": "userImportCollection",
      "type": "LOCAL",
      "spin": true,
      "asJson": true
    }
  ],
  "outputVariable": {
    "key": "postUserImportResponse",
    "type": "LOCAL",
    "spin": true,
    "asJson": false
  },
  "asyncBefore": true
}
