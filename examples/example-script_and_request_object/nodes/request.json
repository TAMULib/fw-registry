{
  "id": "80ee4a88-98ca-42e0-8103-5087347b9379",
  "name": "PUT Item",
  "description": "Example request task to PUT an item.",
  "deserializeAs": "RequestTask",
  "request": {
    "url": "{{{exampleNormalUrlPath}}}/${itemId}",
    "method": "PUT",
    "contentType": "application/json",
    "accept": "text/plain",
    "sendEmptyBody": false,
    "bodyTemplate": "${item}"
  },
  "inputVariables": [
    {
      "key": "itemId",
      "type": "LOCAL"
    },
    {
      "key": "item",
      "type": "LOCAL",
      "spin": true,
      "asJson": true
    }
  ],
  "headerOutputVariables": [],
  "outputVariable": {
    "key": "item",
    "type": "LOCAL",
    "spin": true
  },
  "asyncBefore": true
}
