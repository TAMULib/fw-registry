{
  "id": "f22cb03e-bfc3-4713-9bad-9cab91b31906",
  "name": "Send Success Email",
  "description": "Send the after-action EDI import summary email.",
  "deserializeAs": "EmailTask",
  "inputVariables": [
    {
      "key": "emailTo",
      "type": "PROCESS"
    },
    {
      "key": "emailFrom",
      "type": "PROCESS"
    },
    {
      "key": "successEmail",
      "type": "LOCAL",
      "spin": true
    }
  ],
  "outputVariable": {},
  "mailTo": "${emailTo}",
  "mailFrom": "${emailFrom}",
  "mailSubject": "${successEmail.subject}",
  "mailText": "${successEmail.text}",
  "mailMarkup": "${successEmail.markup}",
  "asyncBefore": true
}
